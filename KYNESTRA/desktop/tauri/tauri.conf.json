{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KYNESTRA",
  "version": "0.1.0",
  "identifier": "com.tamasrazim.kynestra",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KYNESTRA",
        "width": 1440,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
