{
  "version": "0.1",
  "delivery": "durable-log-plus-live-emission",
  "idempotentHandlers": true,
  "events": [
    "project.created",
    "project.updated",
    "project.opened",
    "task.created",
    "task.started",
    "task.progress",
    "task.completed",
    "task.failed",
    "render.started",
    "render.completed",
    "render.failed",
    "asset.imported",
    "submission.updated",
    "account.connected",
    "account.disconnected",
    "account.updated",
    "task.recovered",
    "project.exported",
    "project.imported",
    "task.cancelled"
  ],
  "deliveryGuarantee": "Live Tauri notifications are best-effort; every emitted event is persisted to the project's event log before publication. Future replay consumers can read the persisted log."
}
