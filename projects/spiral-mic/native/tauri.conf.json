{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spiral Mic",
  "version": "0.1.0",
  "identifier": "com.tamasrazim.spiralmic",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Spiral Mic",
        "width": 1160,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"]
  }
}
