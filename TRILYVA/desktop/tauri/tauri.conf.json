{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TRILYVA",
  "version": "0.1.0",
  "identifier": "com.tamasrazim.trilyva",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TRILYVA",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Code-driven motion graphics and frame-accurate rendering",
    "longDescription": "TRILYVA is a code-driven animation workspace with a local media encoding backend.",
    "resources": [
      "resources/bin/*",
      "resources/FFMPEG-THIRD-PARTY-NOTICES.txt"
    ]
  }
}
